#!/usr/bin/env python3
"""Optional repo-local hook. No activation, staging or formatting side effects."""
import os
from pathlib import Path
import re
import subprocess
import sys

BUILD_INPUTS = ['src', 'pom.xml', '.mvn', 'mvnw', 'mvnw.cmd']


def git(*args):
    return subprocess.run(['git', *args], check=True, stdout=subprocess.PIPE).stdout


def java_home():
    configured = os.environ.get('JAVA_HOME')
    if configured:
        candidate = Path(configured)
    elif Path('/usr/libexec/java_home').is_file():
        found = subprocess.run(['/usr/libexec/java_home', '-v', '21'], check=True,
                               stdout=subprocess.PIPE, text=True).stdout.strip()
        candidate = Path(found)
    else:
        raise RuntimeError('Set JAVA_HOME to a Java 21 JDK before committing Java changes.')
    version = subprocess.run([str(candidate / 'bin/java'), '-version'], check=True,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True).stdout
    if not re.search(r'version "21(?:[.\"]|$)', version):
        raise RuntimeError('JAVA_HOME must select Java 21; no checks were run.')
    return str(candidate)


def main():
    root = Path(os.fsdecode(git('rev-parse', '--show-toplevel')).strip())
    os.chdir(root)
    staged = git('diff', '--cached', '--no-renames', '--name-only', '-z').split(b'\0')
    if not any(name.endswith(b'.java') for name in staged):
        print('Pre-commit: no staged Java changes; checks skipped.')
        return 0
    # Verify exactly the staged build inputs, never quietly test different worktree code.
    if git('diff', '--name-only', '-z', '--', *BUILD_INPUTS) or git(
            'ls-files', '--others', '--exclude-standard', '-z', '--', *BUILD_INPUTS):
        raise RuntimeError('Unstaged/untracked build inputs exist. Reconcile them explicitly; this hook does not stage or stash files.')
    env = os.environ.copy()
    env['JAVA_HOME'] = java_home()
    # test already runs Spotless during validate. clean prevents stale removed classes.
    command = ['./mvnw', '-B', '-ntp', '-Dtest=ArchitectureComplianceTest', 'clean', 'test']
    print('Pre-commit: Spotless and ArchUnit only; no PostgreSQL/PIT/Sonar checks.', flush=True)
    return subprocess.run(command, env=env, check=False).returncode


if __name__ == '__main__':
    try:
        sys.exit(main())
    except (OSError, RuntimeError, subprocess.CalledProcessError) as failure:
        # Only controlled diagnostics; subprocess errors do not include captured file contents.
        print('Pre-commit: ' + str(failure), file=sys.stderr)
        sys.exit(1)
